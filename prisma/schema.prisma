generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Content lives in code (lib/seed-data.ts). The database only stores PROGRESS,
// keyed by the stable string IDs from that module. This one small key-value table
// is trivial to back with any database. status: "TODO"|"ATTEMPTED"|"LEARNING"|"DONE".
model Progress {
  key        String   @id
  status     String   @default("TODO")
  confidence Int      @default(0)
  revisit    Boolean  @default(false)
  attempts   Int      @default(0)
  notes      String   @default("")
  updatedAt  DateTime @updatedAt
}
