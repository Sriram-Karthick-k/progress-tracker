# Storage backend for progress data.
#
#   (unset)  -> "local"  : browser localStorage. Works ANYWHERE (Vercel, static,
#                          GitHub Pages). No database needed. THIS IS THE VERCEL DEFAULT.
#   db                   : server API backed by Prisma/SQLite (prisma/dev.db).
#                          Use for the local desktop app; run `npm run db:migrate` once.
#
# NEXT_PUBLIC_* is inlined at build time, so set it before `npm run build`.
NEXT_PUBLIC_STORAGE_MODE=db

# Only needed in db mode. SQLite by default; point at any Prisma-supported DB to
# swap backends (also change datasource `provider` in prisma/schema.prisma).
# DATABASE_URL="file:./dev.db"
